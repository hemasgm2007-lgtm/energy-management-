#include <Wire.h>
#include <BH1750.h>

BH1750 lightSensor;

void setup() {
  Serial.begin(115200);

  Wire.begin(21, 22);

  if (lightSensor.begin()) {
    Serial.println("BH1750 Connected!");
  } else {
    Serial.println("BH1750 NOT CONNECTED!");
  }
}

void loop() {
  float lux = lightSensor.readLightLevel();

  Serial.print("Light: ");
  Serial.print(lux);
  Serial.println(" lux");

  delay(1000);
}