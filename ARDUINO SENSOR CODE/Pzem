#include <PZEM004Tv30.h>

HardwareSerial pzemSerial(2);

PZEM004Tv30 pzem(pzemSerial, 16, 17);

void setup() {
  Serial.begin(115200);

  pzemSerial.begin(9600, SERIAL_8N1, 16, 17);

  Serial.println("PZEM-004T Test");
  Serial.println("----------------");
}

void loop() {

  float voltage = pzem.voltage();
  float current = pzem.current();
  float power   = pzem.power();
  float energy  = pzem.energy();
  float frequency = pzem.frequency();
  float pf = pzem.pf();

  if (isnan(voltage)) {
    Serial.println("PZEM NOT CONNECTED");
  } else {

    Serial.print("Voltage   : ");
    Serial.print(voltage);
    Serial.println(" V");

    Serial.print("Current   : ");
    Serial.print(current);
    Serial.println(" A");

    Serial.print("Power     : ");
    Serial.print(power);
    Serial.println(" W");

    Serial.print("Energy    : ");
    Serial.print(energy);
    Serial.println(" kWh");

    Serial.print("Frequency : ");
    Serial.print(frequency);
    Serial.println(" Hz");

    Serial.print("Power Factor: ");
    Serial.println(pf);
  }

  Serial.println("----------------");
  delay(2000);
}